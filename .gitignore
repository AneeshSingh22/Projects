# env — never commit real values.
# .env.example is the one exception: it documents the required shape with blank values.
.env
.env.*
!.env.example

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage

# vercel
.vercel

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.pem
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
