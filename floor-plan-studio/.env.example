# Copy this file to .env and fill in your key. Never commit .env.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: port for the local backend server (defaults to 8787)
PORT=8787

# Optional: trade cost against accuracy. Defaults shown.
#
# Benchmarked on a real 2-bedroom plan (does each room land in its correct quadrant?):
#   sonnet-5 / medium   2/4   $0.034    16s   <- puts the Living Room in the wrong half
#   sonnet-5 / high     ---            ---    <- overruns max_tokens, output truncates
#   opus-5   / low      4/4   $0.118    35s
#   opus-5   / medium   4/4   $0.263   108s   <- default: same accuracy as high, half the price
#   opus-5   / high     4/4   $0.511   253s
#
# Layout accuracy depends on the MODEL, not the effort — Opus at its cheapest setting beat
# Sonnet at every setting. Raise FLOOR_PLAN_EFFORT if a very complex plan gives trouble.
ANTHROPIC_MODEL=claude-opus-5
FLOOR_PLAN_EFFORT=medium
STYLE_EFFORT=low

# Product-page reading is plain extraction, not spatial reasoning — Haiku does it for ~1/5 the
# price of Opus (about $0.01 vs $0.06 per import).
PRODUCT_MODEL=claude-haiku-4-5
